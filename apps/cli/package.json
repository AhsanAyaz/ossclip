{
  "name": "ossclip",
  "version": "0.1.18",
  "description": "Local-first CLI video producer: cuts silence and fillers, word-timed captions, face-aware framing, and LLM-planned code-rendered graphics — transcription and rendering never leave your machine",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhsanAyaz/ossclip.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "video",
    "cli",
    "captions",
    "remotion",
    "whisper",
    "shorts",
    "video-editing",
    "llm"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ossclip": "./bin/ossclip.mjs"
  },
  "files": [
    "README.md",
    "bin",
    "src",
    "editor-dist"
  ],
  "scripts": {
    "ossclip": "tsx src/index.ts",
    "prepack": "pnpm --filter @ossclip/editor build && node scripts/prepack.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@ossclip/core": "workspace:*",
    "@ossclip/renderer": "workspace:*",
    "@ossclip/scenes": "workspace:*",
    "commander": "^12.1.0",
    "tsx": "^4.19.0",
    "zod": "^3.25.76"
  },
  "homepage": "https://github.com/AhsanAyaz/ossclip#readme",
  "bugs": {
    "url": "https://github.com/AhsanAyaz/ossclip/issues"
  },
  "author": "Muhammad Ahsan Ayaz"
}
